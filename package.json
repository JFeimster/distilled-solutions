{
  "name": "distilled-solutions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "npm run validate",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "generate:manifest": "tsx scripts/generate-solutions-manifest.ts",
    "validate": "tsx scripts/validate-solutions.ts",
    "lint": "eslint app components lib schemas scripts tests --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "audit:routes": "tsx scripts/audit-routes.ts",
    "audit:launch": "tsx scripts/audit-launch.ts",
    "check": "npm run validate && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
